[sub_resource type="GDScript" id="GDScript_goqy1"]
script/source = "extends AnimatedSprite2D
var abrir_ventana = true
#xd
func _on_button_pressed() -> void:
	if abrir_ventana == true:
		$AudioStreamPlayer2D.stream = preload(\"uid://urrv7cy25wv8\")
		$AudioStreamPlayer2D.play()
		$\".\".play(\"default\")
		abrir_ventana = false
	else:
		$AudioStreamPlayer2D.stream = preload(\"uid://dr22th6wsx7k8\")
		$AudioStreamPlayer2D.play()
		$\".\".play_backwards(\"default\")
		abrir_ventana = true
"

